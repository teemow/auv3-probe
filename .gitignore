# XcodeGen output — the project is generated from project.yml, never committed.
*.xcodeproj/

# Xcode build / derived data
DerivedData/
build/
.build/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside

# Swift Package Manager
.swiftpm/
Package.resolved

# xtool (Linux build/sign/install) output — see docs/building-on-linux.md
xtool/

# go-ios pairing identity (contains a private key) — written to the current
# directory when `ios tunnel start` runs without --pair-record-path.
selfIdentity.plist

# XcodeGen-generated extension Info.plists (see project.yml `info:` blocks); the
# canonical NSExtension content lives in project.yml + Extensions/*-Info.plist.
Generated/

# macOS
.DS_Store

# graphify knowledge graph (regenerable, rebuilt by the post-commit hook)
graphify-out/

# Python bytecode (Tests/Scripts imports scripts/ipad-buy and writes it)
__pycache__/
