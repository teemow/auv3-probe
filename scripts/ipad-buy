#!/usr/bin/env python3
# ipad-buy: open an app's page in the App Store on the iPad, read what it
# offers, and, with a person's confirmation, buy or download that one app
# (or that one App Store bundle of apps). Also run as `scripts/ipad buy`.
#
#   ipad-buy <app id or URL>
#       Look only (the default): open the page and print the app's name,
#       developer, price, whether it has in-app purchases, and what the
#       script would refuse. Taps nothing that buys or downloads.
#   ipad-buy <bundle URL>   (https://apps.apple.com/<cc>/app-bundle/<name>/id<id>)
#       The same for an App Store bundle, plus the apps in it with their
#       prices, bundle ids and in-app purchases. A bare id that Apple's lookup
#       does not know is tried as a bundle.
#   ipad-buy <app id or URL> --confirm-name <name> --confirm-price <price>
#       Buy (or get, or re-download) exactly that app: tap its price, Get or
#       re-download button once, then read Apple's sheet from the accessibility
#       tree and say what the person has to do (press the top button twice,
#       Face ID, a password, a sign-in), with a progress line for each step
#       (sheet open, confirmed, downloading, installed). It stops early when
#       the sheet closes without a purchase or shows an error.
#
# --confirm-price takes the price exactly as the look prints it ("22,99 €",
# "$9.99"), `free` for a free app, or `redownload` for an app bought before.
# The script refuses on any difference between the confirmation and the page,
# on a subscription or any other offer it does not know, and on anything it
# cannot read. One app per call.
#
# An agent passes the confirmation only after the person who pays has
# confirmed that app and that total in their own words, for this purchase.
# An earlier approval does not carry over to another app or another price.
#
# Only a person at the iPad can press the top button twice, use Face ID or
# Touch ID, or type a verification code (AssistiveTouch does not stand in for
# the double-press: its menu has no double-click action for the purchase
# sheet, tried on iPadOS 27): the script says so and waits for it
# (Apple closes the sheet after about a minute; the script then reports that
# nothing was bought). With Face ID turned off for "iTunes & App Store" the
# sheet has a plain Buy button instead and then asks for the password, so a
# purchase needs nobody at the iPad (docs/ipad-automation.md). When Apple then
# asks whether later purchases need the password too, the script answers only
# "always require". When the sheet asks for the Apple ID password, and only
# then, the script asks for it at its own terminal prompt (not shown), like
# the passcode in ipad-unlock, types it into the sheet and presses Return;
# Return alone (asked twice) leaves it to be typed on the iPad. The password is not echoed,
# stored or logged and never taken from an argument, the environment, a file
# or a pipe, and an agent never types, stores or passes it. ONE attempt: when
# the sheet asks again, the script stops, because Apple locks an account after
# wrong passwords. It taps the sheet's own Buy or Install button once, only
# when the sheet shows that app (and price). It never buys in-app purchases or
# subscriptions and changes no account, payment, password or App Store
# setting (beyond answering Apple's own question with "always require").
# The Apple Account shown on the sheet is left out of what it prints.
#
# The bundle id the install check waits for, and a cross-check of name and
# price, come from Apple's public lookup (itunes.apple.com/lookup), which is
# sent the app id and the country and nothing else.
#
# A bundle is one purchase at one price. The lookup has no entry for bundles,
# so its name, price and apps come from Apple's public web page of the bundle
# (apps.apple.com/<cc>/app-bundle/id<id>, sent the id and the country and
# nothing else), and each app in it is checked against the lookup by its id.
# The script buys a bundle only at its price and only while none of its apps
# is bought or installed: Apple then asks a reduced "complete my bundle" price
# that no public source confirms (buy the other apps one by one instead). It
# refuses when the iPad lists other apps than Apple's page, and it waits until
# every app in the bundle is installed and its row on the page reads Open.
#
# Options:
#   --timeout <seconds>  how long to wait for the install (default 600)
#   --country <cc>       App Store country for the cross-check against
#                        Apple's public lookup (default: from the URL, else
#                        the iPad's region)
#
# Needs WebDriverAgent running (`scripts/ipad wda`), the go-ios tunnel (the
# install check uses `ios apps`) and python3. It takes the iPad lock
# $IPAD_LOCK (default ~/.cache/go-ios/ipad.lock) and refuses while another
# holder has it; a caller that already holds the lock sets IPAD_LOCK_HELD=1.
# Overrides: IPAD_WDA_URL or WDA_PORT, GOIOS_CACHE, IPAD_LOCK.
import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

WDA = os.environ.get("IPAD_WDA_URL") or f"http://127.0.0.1:{os.environ.get('WDA_PORT', '8100')}"
CACHE = os.environ.get("GOIOS_CACHE") or os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "go-ios")
LOCK = os.environ.get("IPAD_LOCK") or os.path.join(CACHE, "ipad.lock")
STORE = "com.apple.AppStore"
AUM = "com.kymatica.AUM"

# Words on the App Store's buttons, in the languages the iPad may be set to.
# The script refuses whatever it does not recognise, so a missing language
# makes it refuse, never buy.
GET_WORDS = {"get", "laden", "gratis", "free", "obtenir", "obtener", "ottieni"}
OPEN_WORDS = {"open", "öffnen", "ouvrir", "abrir", "apri"}
REDOWNLOAD_WORDS = {"redownload", "download", "erneut laden", "herunterladen"}
IAP_WORDS = ("in-app purchases", "in-app-käufe", "achats intégrés", "compras dentro de la app",
             "acquisti in-app")
YES_WORDS = {"yes", "ja", "oui", "sí", "si"}
SUBSCRIPTION = re.compile(r"abo|subscri|arcade|trial|testen|monat|month|jahr|year|woche|week",
                          re.IGNORECASE)
# Texts of the purchase and authentication sheets, read from the accessibility
# tree after the tap. The sheet's own confirm button:
CONFIRM_WORDS = {"kaufen", "kauf", "buy", "purchase", "installieren", "install", "acheter", "comprar",
                 "acquista", "installer", "instalar", "installa"}
# Apple's double-press of the top button ("Mit Taste bestätigen", banner "Zum
# Zahlen zweimal drücken"; "Confirm with Side Button", "Double-click to pay").
DOUBLE_PRESS = re.compile(r"zweimal|doppel|double.?(click|press)|twice|mit taste bestätigen|"
                          r"confirm with (the )?(side|top) button|seitentaste|obere taste|"
                          r"side button|top button|deux fois|dos veces|due volte", re.IGNORECASE)
# Offer button states the App Store shows while its sheet is still open; they
# say nothing about whether the purchase went through.
PENDING_STATES = {"loading"}
BIOMETRIC = re.compile(r"face id|touch id", re.IGNORECASE)
CODE = re.compile(r"code", re.IGNORECASE)
SIGN_IN = re.compile(r"\banmelden\b|\bsign in\b|\bse connecter\b|iniciar sesión|accedi", re.IGNORECASE)
ERROR = re.compile(r"fehlgeschlagen|\bfailed\b|konnte nicht|could not|couldn.t|nicht abgeschlossen|"
                   r"cannot be completed|abgelehnt|declined|nicht möglich|not possible|"
                   r"nicht verfügbar|not available|\bfehler\b|\berror\b", re.IGNORECASE)
# After the password, Apple asks once whether later purchases need it too
# ("Passwort für weitere Käufe auf diesem Gerät erfordern?"). The script
# answers only with the stricter choice, "always": it never turns the
# password off for later purchases.
ALWAYS_ASK = re.compile(r"weitere käufe|additional purchases|further purchases", re.IGNORECASE)
ALWAYS_WORDS = {"immer anfordern", "always require"}
SHEET = re.compile(r"kaufen|\bbuy\b|einmalige gebühr|one.time|purchase|installieren|\binstall\b|"
                   r"apple[- ]?account", re.IGNORECASE)


class Refusal(Exception):
    pass


def say(msg=""):
    print(msg, flush=True)


def die(msg):
    print(f"ipad-buy: {msg}", file=sys.stderr, flush=True)
    sys.exit(1)


def shown(s):
    """A page text for messages: quoted, no-break spaces as plain ones."""
    return '"' + " ".join(unicodedata.normalize("NFKC", s or "").split()) + '"'


def norm(s):
    """Compare texts the way they read: no-break spaces as spaces, case-blind."""
    s = unicodedata.normalize("NFKC", s or "")
    s = s.replace(" ", " ").replace(" ", " ").replace("⁨", "").replace("⁩", "")
    s = s.replace("⁦", "").replace("⁧", "")
    return " ".join(s.split()).casefold()


# --- WebDriverAgent -------------------------------------------------------

def call(method, path, body=None, timeout=60):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(WDA + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            return json.load(e)
        except Exception:
            raise SystemExit(f"ipad-buy: WebDriverAgent answered {e.code} on {path}")
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise SystemExit(f"ipad-buy: WebDriverAgent does not answer on {WDA} ({e}); "
                         "start it with: scripts/ipad wda")


class Session:
    def __init__(self, bundle):
        # Without a bundle the session activates nothing (read_app points it).
        caps = {"shouldWaitForQuiescence": False}
        if bundle:
            caps.update({"bundleId": bundle, "forceAppLaunch": False, "shouldTerminateApp": False})
        r = call("POST", "/session", {"capabilities": {"alwaysMatch": caps}})
        self.sid = (r.get("value") or {}).get("sessionId") or r.get("sessionId")
        if not self.sid:
            raise SystemExit(f"ipad-buy: WebDriverAgent opened no session for {bundle}")
        self.post("/appium/settings", {"settings": {"waitForIdleTimeout": 0,
                                                    "animationCoolOffTimeout": 0}})

    def post(self, path, body):
        return call("POST", f"/session/{self.sid}{path}", body)

    def read_app(self, bundle):
        """Point the session's queries at a running app without launching it."""
        self.post("/appium/settings", {"settings": {"defaultActiveApplication": bundle}})

    def get(self, path):
        return call("GET", f"/session/{self.sid}{path}")

    def close(self):
        try:
            call("DELETE", f"/session/{self.sid}", timeout=10)
        except SystemExit:
            pass

    def source(self):
        return self.get("/source?format=json").get("value") or {}

    def swipe_up(self):
        self.post("/actions", {"actions": [{
            "type": "pointer", "id": "finger", "parameters": {"pointerType": "touch"},
            "actions": [{"type": "pointerMove", "duration": 0, "x": 300, "y": 650},
                        {"type": "pointerDown", "button": 0},
                        {"type": "pointerMove", "duration": 600, "x": 300, "y": 350},
                        {"type": "pause", "duration": 300},
                        {"type": "pointerUp", "button": 0}]}]})

    def find(self, predicate):
        r = self.post("/elements", {"using": "predicate string", "value": predicate})
        found = r.get("value")
        if not isinstance(found, list):
            return []
        return [el.get("ELEMENT") or next(iter(el.values())) for el in found]

    def rect(self, eid):
        return self.get(f"/element/{eid}/rect").get("value") or {}


def walk(node, parents=()):
    """Yield (node, ancestors) for every element of a WDA JSON source tree."""
    yield node, parents
    for child in node.get("children") or []:
        yield from walk(child, parents + (node,))


def ident(n):
    return n.get("name") or ""


def label(n):
    return n.get("label") or ""


# --- The page ---------------------------------------------------------------

def app_id_of(arg):
    """(id, country from the URL or None, whether the URL names a bundle)."""
    m = re.fullmatch(r"(?:id)?(\d{5,12})", arg.strip())
    if m:
        return m.group(1), None, False
    u = urllib.parse.urlparse(arg.strip())
    if u.scheme in ("https", "http", "itms-apps") and u.netloc in ("apps.apple.com", "itunes.apple.com"):
        m = re.search(r"/id(\d{5,12})(?:$|[/?])", u.path + "/")
        if m:
            cc = re.match(r"/([a-z]{2})/", u.path)
            return m.group(1), cc.group(1) if cc else None, "/app-bundle/" in u.path
    die(f"not an App Store app id or URL: {arg!r} (e.g. 1234567890, "
        "https://apps.apple.com/<cc>/app/<name>/id1234567890 or "
        "https://apps.apple.com/<cc>/app-bundle/<name>/id1234567890)")


def device_country():
    try:
        out = subprocess.run(["ios", "lang"], capture_output=True, text=True, timeout=30).stdout
        loc = json.loads(out.strip().splitlines()[-1]).get("Locale", "")
    except Exception:
        return None
    m = re.search(r"_([A-Z]{2})$", loc)
    return m.group(1).lower() if m else None


def lookup(app_id, country):
    """Apple's public catalogue entry for the id: name, developer, price, bundle id."""
    q = urllib.parse.urlencode({"id": app_id, "country": country or "us"})
    try:
        with urllib.request.urlopen(f"https://itunes.apple.com/lookup?{q}", timeout=30) as r:
            results = json.load(r).get("results") or []
    except Exception as e:
        say(f"note: Apple's lookup did not answer ({e})")
        return None
    return results[0] if results else None


def bundle_lookup(bundle_id, country):
    """Apple's public web page of an App Store bundle, which the lookup does
    not know: name, price, developer and the apps in it. None when there is
    no such bundle or the page cannot be read."""
    url = f"https://apps.apple.com/{country or 'us'}/app-bundle/id{bundle_id}"
    try:
        with urllib.request.urlopen(url, timeout=30) as r:
            html = r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        if e.code != 404:
            say(f"note: Apple's bundle page did not answer ({e})")
        return None
    except Exception as e:
        say(f"note: Apple's bundle page did not answer ({e})")
        return None
    return parse_bundle_page(html, bundle_id)


def parse_bundle_page(html, bundle_id):
    """The bundle from the page's own data (the JSON the App Store web app
    renders from); None for any other page or a shape this does not know."""
    m = re.search(r"<script[^>]*\bid=[\"']?serialized-server-data[\"']?[^>]*>(.*?)</script>", html, re.S)
    if not m:
        return None
    try:
        data = json.loads(m.group(1))["data"][0]
        intent, page = data["intent"], data["data"]
        if intent.get("$kind") != "BundlePageIntent" or str(intent.get("id")) != str(bundle_id):
            return None
        offer = page["titleOfferDisplayProperties"]
        apps = []
        for child in page["lockup"]["children"]:
            o = child.get("offerDisplayProperties") or {}
            iap = o.get("hasInAppPurchases")
            apps.append({"id": str(child["adamId"]), "name": child["title"],
                         "bundleId": child.get("bundleId"), "formattedPrice": o.get("priceFormatted"),
                         "iap": iap if isinstance(iap, bool) else None})
        if not apps:
            return None
        return {"kind": "bundle", "trackName": page["title"], "formattedPrice": offer["priceFormatted"],
                "price": 0 if offer.get("isFree") is True else None,
                "artistName": (page.get("developerAction") or {}).get("title"),
                "regularPrice": page.get("regularPriceFormatted"), "apps": apps}
    except (KeyError, IndexError, TypeError, ValueError, AttributeError):
        return None


def catalogue(app_id, country, bundle):
    """(Apple's public entry for the id, whether it is a bundle). An app's
    entry is the lookup's. A bundle (named so by its URL, or an id the lookup
    does not know) comes from its web page, with each app in it looked up by
    its id and whether `ios apps` lists it already."""
    entry = None if bundle else lookup(app_id, country)
    if entry is None:
        found = bundle_lookup(app_id, country)
        if found:
            entry, bundle = found, True
    if bundle and entry:
        for a in entry["apps"]:
            a["lookup"] = lookup(a["id"], country)
        entry["installed"] = listed([a["bundleId"] for a in entry["apps"] if a.get("bundleId")])
    return entry, bundle


def offer_kind(state, text):
    """What the main button does: price, get, open, redownload or None (unknown)."""
    t = norm(text)
    if state == "open" or t in OPEN_WORDS:
        return "open" if state == "open" else None
    if state in ("redownload", "download", "cloud") or t in REDOWNLOAD_WORDS:
        return "redownload"
    if state != "get":
        return None
    if t in GET_WORDS:
        return "get"
    if re.search(r"\d", t) and not SUBSCRIPTION.search(t):
        return "price"
    return None


class Page:
    def __init__(self):
        self.title = None
        self.offer = None          # (state, label) of the top lockup's button
        self.offer_rect = None
        self.notices = []          # other texts in the top lockup
        self.developer = None
        self.iap = None            # "yes", "no" or None (not read)
        self.info_seen = False
        self.info_done = False
        self.children = {}         # a bundle's apps: app id -> (title, (state, label) or None)

    def read_children(self, tree):
        """A bundle page's rows of the apps in it ("2 Apps in diesem Paket")."""
        for n, _ in walk(tree):
            m = re.match(r"AppStore\.shelfItem\.smallLockup\[id=(\d+),parentId=bundleChildren[,\]]", ident(n))
            if not m:
                continue
            title, offers = None, set()
            for c, _ in walk(n):
                i, l = ident(c), label(c)
                if i == "AppStore.shelfItemSubComponent.title":
                    title = l
                elif i.startswith("AppStore.offerButton"):
                    s = re.search(r"state=([^\],]+)", i)
                    offers.add((s.group(1) if s else "", l))
            # Buttons nest a copy of themselves; two distinct ones are unreadable.
            self.children[m.group(1)] = (title, offers.pop() if len(offers) == 1 else None)

    def read_top(self, tree):
        self.read_children(tree)
        lockup = None
        for n, _ in walk(tree):
            if ident(n).startswith("AppStore.shelfItem.productTopLockup"):
                lockup = n
                break
        if lockup is None:
            return False
        offers = []
        for n, _ in walk(lockup):
            i, l = ident(n), label(n)
            if i == "AppStore.shelfItemSubComponent.title":
                self.title = l
            elif i.startswith("AppStore.offerButton"):
                m = re.search(r"state=([^\],]+)", i)
                offers.append((m.group(1) if m else "", l, n.get("rect")))
            elif i in ("AppStore.shelfItemSubComponent.tagline", "AppStore.shelfItemSubComponent.icon"):
                pass
            elif i == "AppStore.shelfItemSubComponent.developer" and l:
                self.developer = l
            elif i == "AppStore.shelfItemSubComponent.offerButtonSubtitle" and norm(l) in IAP_WORDS:
                self.iap = "yes"
            elif l and n.get("type") in ("StaticText", "TextView", "Link", "Button", "Image"):
                if (i, l) not in self.notices:
                    self.notices.append((i, l))
        # Buttons nest a copy of themselves; count distinct ones by label and state.
        distinct = {(s, l) for s, l, _ in offers}
        if len(distinct) == 1:
            self.offer = offers[0][:2]
            self.offer_rect = offers[0][2]
        elif len(distinct) > 1:
            self.offer = None
            self.notices.append(("", "more than one offer button: " + "; ".join(sorted(l for _, l in distinct))))
        return bool(self.title)

    def read_rest(self, tree):
        # "No in-app purchases" is read only from one screen that holds the
        # Information header and what follows the section, so no row of it
        # can have been between two screens.
        header = False
        for n, _ in walk(tree):
            i, l = ident(n), label(n)
            if i == "AppStore.shelfItemSubComponent.developerLink" and not self.developer:
                self.developer = l.rsplit(",", 1)[0].strip() if "," in l else l
            elif i.startswith("AppStore.shelf.header") and "parentId=information" in i:
                header = self.info_seen = True
            elif header and (i.startswith("AppStore.shelfItem.productPageLink")
                             or i.startswith("AppStore.shelf.header")):
                self.info_done = True
            elif n.get("type") == "Button" and i == l and "," in l:
                head, value = (p.strip() for p in l.split(",", 1))
                if norm(head) in IAP_WORDS:
                    self.iap = "yes" if norm(value) in YES_WORDS else "unreadable"
        if self.info_done and self.iap is None:
            self.iap = "no"


def open_page(app_id, expect=None, wait=20, bundle=False, apps=()):
    """Open the app's (or the bundle's) page; wait until it shows a title and
    an offer (and the expected name, when Apple's lookup knows it, and the
    rows of the bundle's apps), at most `wait` seconds."""
    s = Session(STORE)
    try:
        s.post("/url", {"url": f"itms-apps://apps.apple.com/{'app-bundle' if bundle else 'app'}/id{app_id}"})
        # A product page pushed on top of another one shows the old one first.
        time.sleep(2)
        deadline = time.time() + wait
        while True:
            page = Page()
            if page.read_top(s.source()) and page.offer and (expect is None or norm(page.title) == norm(expect)) \
                    and set(apps) <= set(page.children):
                break
            if time.time() > deadline:
                break
            time.sleep(1)
        return s, page
    except BaseException:
        s.close()
        raise


def read_page(app_id, expect, bundle=False, apps=()):
    s, page = open_page(app_id, expect, bundle=bundle, apps=apps)
    try:
        if not page.title:
            return page
        for _ in range(30):
            page.read_rest(s.source())
            if page.info_done:
                break
            s.swipe_up()
            time.sleep(0.6)
        return page
    finally:
        s.close()


# --- Checks ---------------------------------------------------------------

def price_text(kind, offer_label):
    return {"price": offer_label, "get": "free", "redownload": "redownload",
            "open": "installed"}.get(kind, "unreadable")


def check(page, entry, args):
    """Return the list of reasons not to tap. Empty means the page matches."""
    reasons = []
    if not page.title:
        return ["the page shows no app title (no such app, no network, or not the App Store)"]
    kind = offer_kind(*page.offer) if page.offer else None
    if kind is None:
        reasons.append(f"the main button is not a price, Get or re-download button: {shown(page.offer[1]) if page.offer else 'none'}")
    elif kind == "open":
        reasons.append("the app is installed already")
    if page.offer and SUBSCRIPTION.search(page.offer[1]):
        reasons.append(f"the offer reads like a subscription: {shown(page.offer[1])}")
    for i, n in page.notices:
        reasons.append(f"the page shows a notice next to the offer: {shown(n)} ({i or 'no identifier'})")
    if not page.developer:
        reasons.append("the developer could not be read")
    if page.iap is None or page.iap == "unreadable":
        reasons.append("whether the app has in-app purchases could not be read")
    if entry is None:
        reasons.append("Apple's lookup (for a bundle: its public bundle page) has no entry for this id "
                       "in this country (try --country)")
    else:
        if entry.get("kind") == "bundle":
            reasons += check_bundle(page, entry, kind)
        if norm(entry.get("trackName")) != norm(page.title):
            reasons.append(f"the page title {shown(page.title)} is not the id's name {shown(entry.get('trackName'))}: "
                           "the wrong page may be in front")
        if kind == "price" and norm(entry.get("formattedPrice")) != norm(page.offer[1]):
            reasons.append(f"the page price {shown(page.offer[1])} differs from Apple's lookup "
                           f"{shown(entry.get('formattedPrice'))}")
        if kind == "get" and entry.get("price") not in (0, 0.0):
            reasons.append(f"the page offers Get, Apple's lookup a price of {shown(entry.get('formattedPrice'))}")
    if args.confirm_name is not None and norm(args.confirm_name) != norm(page.title):
        reasons.append(f"--confirm-name {shown(args.confirm_name)} is not the page's name {shown(page.title)}")
    if args.confirm_price is not None and kind is not None:
        if norm(args.confirm_price) != norm(price_text(kind, page.offer[1])):
            reasons.append(f"--confirm-price {shown(args.confirm_price)} is not the page's price "
                           f"{shown(price_text(kind, page.offer[1]))}")
    return reasons


def check_bundle(page, entry, kind):
    """The reasons not to buy a bundle, on top of those for any page."""
    reasons = []
    if kind not in (None, "price"):
        reasons.append(f"a bundle is bought only at its price, and its button reads "
                       f"{shown(page.offer[1]) if page.offer else 'none'} (the apps of a bundle "
                       "bought before are downloaded one by one)")
    apps = entry["apps"]
    if sorted(page.children) != sorted(a["id"] for a in apps):
        reasons.append(f"the page lists {len(page.children)} apps in the bundle "
                       f"({', '.join(shown(t) for t, _ in page.children.values()) or 'none'}), Apple's "
                       f"bundle page {len(apps)} ({', '.join(shown(a['name']) for a in apps)})")
    have = entry.get("installed")
    if have is None:
        reasons.append("`ios apps` does not answer: whether an app of the bundle is installed already "
                       "could not be read")
    for a in apps:
        name, row, lk = shown(a["name"]), page.children.get(a["id"]), a.get("lookup")
        if row:
            title, offer = row
            if norm(title) != norm(a["name"]):
                reasons.append(f"the page names app {a['id']} {shown(title)}, Apple's bundle page {name}")
            if (offer_kind(*offer) if offer else None) not in ("price", "get"):
                reasons.append(f"{name} is bought or installed already, or its button cannot be read "
                               f"({shown(offer[1]) if offer else 'none'}): Apple then asks a reduced price "
                               "for the bundle that no public source confirms. Get the other apps one by one.")
        if have and a.get("bundleId") in have:
            reasons.append(f"{name} ({a['bundleId']}) is installed already")
        if not a.get("bundleId"):
            reasons.append(f"Apple's bundle page gives no bundle id for {name}")
        if lk is None:
            reasons.append(f"Apple's lookup has no entry for {name} (id {a['id']}) in this country")
        else:
            if norm(lk.get("trackName")) != norm(a["name"]):
                reasons.append(f"Apple's lookup names app {a['id']} {shown(lk.get('trackName'))}, the bundle "
                               f"page {name}")
            if lk.get("bundleId") != a.get("bundleId"):
                reasons.append(f"Apple's lookup gives {name} the bundle id {lk.get('bundleId')}, the bundle "
                               f"page {a.get('bundleId')}")
        if a.get("iap") is None:
            reasons.append(f"whether {name} has in-app purchases could not be read")
    return reasons


def report(app_id, page, entry):
    kind = offer_kind(*page.offer) if page.offer else None
    bundle = bool(entry) and entry.get("kind") == "bundle"
    if bundle:
        say(f"bundle:      {app_id} (an App Store bundle of {len(entry['apps'])} apps, one purchase)")
    else:
        say(f"app id:      {app_id}")
    say(f"name:        {page.title or 'unreadable'}")
    say(f"developer:   {page.developer or 'unreadable'}")
    say(f"price:       {price_text(kind, page.offer[1]) if page.offer else 'unreadable'}"
        + (f"   (button: {shown(page.offer[1])})" if page.offer else ""))
    say(f"in-app purchases: {page.iap or 'unreadable'}")
    if bundle:
        have = entry.get("installed")
        say("apps in it:")
        for a in entry["apps"]:
            row = page.children.get(a["id"])
            button = shown(row[1][1]) if row and row[1] else "unreadable"
            iap = {True: "yes", False: "no"}.get(a.get("iap"), "unreadable")
            say(f"  {a['name']}: {a.get('formattedPrice')} alone (button {button}), bundle id "
                f"{a.get('bundleId')}, in-app purchases: {iap}"
                + (", installed" if have and a.get("bundleId") in have else ""))
        say(f"bundle page: {entry.get('trackName')} by {entry.get('artistName')}, {entry.get('formattedPrice')}"
            + (f" (the apps alone: {entry.get('regularPrice')})" if entry.get("regularPrice") else ""))
    elif entry:
        say(f"bundle id:   {entry.get('bundleId')}")
        say(f"lookup:      {entry.get('trackName')} by {entry.get('artistName')}, {entry.get('formattedPrice')}")


# --- Installing -------------------------------------------------------------

def listed(bundles):
    """Which of these bundle ids `ios apps` lists; None when it does not answer."""
    try:
        out = subprocess.run(["ios", "apps"], capture_output=True, text=True, timeout=60).stdout
        data = json.loads(out.strip().splitlines()[-1])
    except Exception:
        return None
    apps = data if isinstance(data, list) else data.get("apps", [])
    ids = {a.get("CFBundleIdentifier") for a in apps}
    return {b for b in bundles if b in ids}


def finished(top, apps):
    """Whether the page proves the install: the app's button reads Open, or,
    for a bundle, the row of every app in it does (the bundle's own button
    never reads Open)."""
    if not apps:
        return bool(top.offer) and top.offer[0] == "open"
    rows = getattr(top, "children", None) or {}
    return all(rows.get(a) and rows[a][1] and rows[a][1][0] == "open" for a in apps)


def front_bundle():
    v = call("GET", "/wda/activeAppInfo", timeout=15).get("value") or {}
    return v.get("bundleId") or ""


def ipad_locked():
    return call("GET", "/wda/locked", timeout=10).get("value") is True


SPRINGBOARD = "com.apple.springboard"
CLOCK = re.compile(r"^\d{1,2}[:.]\d{2}( ?[ap]\.?m\.?)?$", re.IGNORECASE)   # the status bar's time
EMAIL = re.compile(r"[^\s@,;:]+@[^\s@,;:]+\.[a-z]{2,}", re.IGNORECASE)


def private(t):
    """A sheet text for the terminal, with the Apple Account taken out: an
    agent may run this, and the account is nobody else's business."""
    t = " ".join(unicodedata.normalize("NFKC", t or "").split())
    if re.match(r"(apple[- ]?)?(account|konto|id)\b", t, re.IGNORECASE) and ":" in t:
        return t.split(":", 1)[0] + ": (hidden)"
    return EMAIL.sub("(hidden)", t)


class Screen:
    """What the iPad shows besides the product page: Apple's purchase sheet,
    a sign-in, an alert, SpringBoard's banner. Read through the one session
    `s` (WebDriverAgent keeps a single session: a second one would end the
    first), pointed in turn at the App Store, SpringBoard and the app in
    front, and pointed back at the App Store at the end."""

    def __init__(self, s):
        self.texts, self.alerts = [], []
        self.secure = self.fields = self.confirm = self.always = []
        self.always_where = None
        self.where = None          # bundle that holds the fields and buttons
        front = front_bundle()
        bundles = [STORE, SPRINGBOARD] + ([front] if front and front not in (STORE, SPRINGBOARD) else [])
        try:
            for bundle in bundles:
                s.read_app(bundle)
                for n, parents in walk(s.source()):
                    if any(ident(p) == "AppStore.productPage" for p in parents) or ident(n).startswith("AppStore."):
                        continue
                    l = label(n)
                    if n.get("type") == "Alert" and l:
                        self.alerts.append(l)
                    if l and n.get("type") in ("StaticText", "Button", "TextView", "Link", "Alert", "Other") \
                            and l not in self.texts and not CLOCK.match(l):
                        self.texts.append(l)
                # Fields and buttons by query: the JSON tree may leave out an
                # empty field's type.
                secure = s.find("type == 'XCUIElementTypeSecureTextField'")
                # The App Store's own search field is no sign-in.
                fields = s.find("type == 'XCUIElementTypeTextField' AND NOT (name BEGINSWITH 'AppStore.')"
                                " AND NOT (type == 'XCUIElementTypeSearchField')"
                                " AND NOT (name CONTAINS[c] 'search' OR name CONTAINS[c] 'such'"
                                " OR placeholderValue CONTAINS[c] 'search' OR placeholderValue CONTAINS[c] 'such')")
                # WebDriverAgent matches nothing with `label IN[c] {...}`:
                # one comparison per word. On iPadOS 27 the sheet is
                # SpringBoard's, its button `pay-now` labelled "Kauf".
                words = " OR ".join(f"label ==[c] {json.dumps(w)}" for w in sorted(CONFIRM_WORDS))
                confirm = s.find("type == 'XCUIElementTypeButton' AND NOT (name BEGINSWITH 'AppStore.')"
                                 f" AND ({words})")
                always = s.find("type == 'XCUIElementTypeButton' AND ("
                                + " OR ".join(f"label ==[c] {json.dumps(w)}" for w in sorted(ALWAYS_WORDS)) + ")")
                if always and self.always_where is None:
                    self.always, self.always_where = always, bundle
                if (secure or fields or confirm) and self.where is None:
                    self.where, self.secure, self.fields, self.confirm = bundle, secure, fields, confirm
        finally:
            s.read_app(STORE)

    def any(self, pattern):
        return [t for t in self.texts if pattern.search(t)]

    def shows(self, text):
        return norm(text) in norm(" | ".join(self.texts))

    def state(self):
        """What the screen asks for, most specific first."""
        if self.any(ERROR) or [a for a in self.alerts if ERROR.search(a)]:
            return "error"
        if self.always and self.any(ALWAYS_ASK):
            return "always-ask"
        if self.secure:
            return "password"
        if self.fields and self.any(CODE):
            return "code"
        if self.fields or self.any(SIGN_IN):
            return "sign-in"
        if self.any(DOUBLE_PRESS):
            return "double-press"
        if self.any(BIOMETRIC):
            return "biometric"
        if self.confirm:
            return "confirm"
        if self.any(SHEET):
            return "sheet"
        return None


# What the person has to do, in plain words, for each state of the sheet.
TODO = {
    "double-press": "ON THE IPAD: press the top button (the power button) twice, quickly, to pay. "
                    "Apple lets only a person at the iPad do this; nothing from this desk can (taps "
                    "do not, and AssistiveTouch's menu has no double-click for it). The sheet waits "
                    "about a minute, then closes without buying.",
    "biometric": "ON THE IPAD: confirm with Face ID or Touch ID. Only a person at the iPad can do this.",
    "code": "ON THE IPAD: type the verification code Apple sent into the sheet. This script does "
            "not type codes.",
    "sign-in": "ON THE IPAD: sign in to the App Store in the sheet. This script does not type "
               "account names.",
    "password-iPad": "ON THE IPAD: type the Apple ID password into the sheet (this run has no "
                     "terminal to ask at).",
    "password-left": "ON THE IPAD: type the Apple ID password into the sheet (the prompt here "
                     "was left empty twice).",
}


def ask_password():
    """The Apple ID password from the person at this terminal; "" when they
    leave it to the iPad, None without a terminal. An empty answer is asked
    once more: a terminal multiplexer can send a stray Return on attach."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None
    import getpass
    prompts = ("The sheet asks for the Apple ID password. Type it here (not shown; "
               "Return alone to type it on the iPad instead): ",
               "That was empty. Type the password (not shown), or Return alone again to "
               "type it on the iPad: ")
    try:
        for prompt in prompts:
            pw = getpass.getpass(prompt)
            if pw:
                return pw
    except (EOFError, KeyboardInterrupt):
        pass
    return ""


def enter_password(s, screen, pw):
    """Type the person's password into the sheet once and press Return.
    Returns a message when it stopped before anything was submitted."""
    if len(screen.secure) != 1:
        return f"the sheet has {len(screen.secure)} password fields, not one. Nothing was typed."
    field = screen.secure[0]
    s.read_app(screen.where)
    try:
        s.post(f"/element/{field}/click", {})
        time.sleep(0.4)
        res = s.post(f"/element/{field}/value", {"value": list(pw)})
        failed = isinstance(res.get("value"), dict) and res["value"].get("error")
        # A secure field reads as one bullet per character typed.
        shown_len = len(s.get(f"/element/{field}/attribute/value").get("value") or "")
        if failed or shown_len != len(pw):
            s.post(f"/element/{field}/clear", {})
            return ("typing into the password field did not take every character; the field was "
                    "cleared and nothing was submitted.")
        s.post("/wda/keys", {"value": ["\n"]})
    finally:
        del pw
        s.read_app(STORE)
    return None


def tap_offer(s, page):
    state, text = page.offer
    pred = f"name == {json.dumps('AppStore.offerButton[state=' + state + ']')} AND label == {json.dumps(text)}"
    want = page.offer_rect or {}
    for eid in s.find(pred):
        r = s.rect(eid)
        if all(abs(float(r.get(k, -1)) - float(want.get(k, -2))) < 1 for k in ("x", "y", "width", "height")):
            res = s.post(f"/element/{eid}/click", {})
            err = (res.get("value") or {}).get("error") if isinstance(res.get("value"), dict) else None
            if err:
                raise Refusal(f"the tap on the button failed ({err})")
            return
    raise Refusal("the button seen on the page could not be found again to tap it. Nothing was tapped.")


def stamp(start):
    return f"[{int(time.time() - start):>3} s]"


def buy(app_id, entry, page_read, args):
    # For a bundle: its apps' ids and the bundle ids the install check waits for.
    apps = {a["id"]: a["bundleId"] for a in entry["apps"]} if entry.get("kind") == "bundle" else None
    if listed(list(apps.values()) if apps else [entry["bundleId"]]) is None:
        raise Refusal("`ios apps` does not answer (is the go-ios tunnel up?). Nothing was tapped.")
    s, page = open_page(app_id, page_read.title, bundle=bool(apps), apps=apps or ())
    try:
        # The page as it is now, at the top, must still be what was checked.
        if (page.title, page.offer, page.notices, page.children) != \
                (page_read.title, page_read.offer, page_read.notices, page_read.children):
            raise Refusal(f"the page changed between reading and tapping ({shown(page.title)}, {shown(page.offer[1]) if page.offer else 'none'}). "
                          "Nothing was tapped.")
        tap_offer(s, page)
        start = time.time()
        say(f"{stamp(start)} tapped {shown(page.offer[1])} once; reading what the iPad shows "
            f"(Ctrl-C stops this script, not the purchase)")
        return follow(s, page, apps or entry["bundleId"], args, start)
    finally:
        s.close()


def follow(s, page, target, args, start):
    """Watch the sheet and the page after the tap, say what the person must
    do, and report each step until the app is installed or it is clear that
    it will not be. `target` is the app's bundle id or, for an App Store
    bundle, a dict of the ids of the apps in it to their bundle ids."""
    apps = target if isinstance(target, dict) else None
    bundles = sorted(apps.values()) if apps else [target]
    bundle = ", ".join(bundles)                # for messages
    what = "bundle" if apps else "app"
    rows = dict(getattr(page, "children", None) or {}) if apps else {}
    kind = offer_kind(*page.offer)
    deadline = start + args.timeout
    seen_sheet = confirmed = typed = asked = warned = False
    last_state, last_texts, last_offer = "start", None, page.offer
    quiet_since = said_at = start
    gone = 0                   # reads in a row without a sheet, after one was seen
    while time.time() < deadline:
        time.sleep(1.5)
        now = time.time()
        if now - said_at >= 20:
            said_at = now
            say(f"{stamp(start)} still waiting: " + (
                {"double-press": "for the double-press of the top button on the iPad",
                 "biometric": "for Face ID or Touch ID on the iPad",
                 "password": "for the password on the iPad",
                 "code": "for the verification code on the iPad",
                 "sign-in": "for the sign-in on the iPad",
                 "locked": "unlock the iPad so installation can be verified",
                 "sheet": "the purchase sheet is open",
                 "confirm": "the purchase sheet is open"}.get(last_state)
                or ("downloading" if confirmed else "for a purchase sheet")))
        if ipad_locked():
            if last_state != "locked":
                say(f"{stamp(start)} the iPad has locked its screen; a confirmed purchase still "
                    f"downloads. Unlock it to verify {bundle}: the App Store's Open button "
                    "cannot be read while it is locked.")
                last_state = "locked"
            # ios apps can list a download placeholder. Only the unlocked
            # page's Open button together with that listing proves completion.
            continue
        top = Page()
        top.read_top(s.source())
        got = listed(bundles)
        is_in = None if got is None else len(got) == len(bundles)     # all of them
        if is_in and finished(top, apps):
            say(f"{stamp(start)} installed: {page.title} ({bundle})")
            return True
        if top.offer and top.offer != last_offer:
            # The App Store sets the button to "loading" ("Download
            # vorbereiten") as soon as its sheet opens, before anything is
            # paid: only a later state, or the sheet closing on a changed
            # button (below), says the purchase went through.
            progressed = top.offer != page.offer and top.offer[0] not in PENDING_STATES
            say(f"{stamp(start)} the {what}'s button now reads {shown(top.offer[1])} (state {top.offer[0]})"
                + ("; the purchase went through, downloading" if progressed else
                   "; the App Store waits for the purchase sheet" if top.offer[0] in PENDING_STATES else ""))
            if progressed:
                seen_sheet = confirmed = True
            last_offer = top.offer
        for a in apps or ():
            # A bundle's apps download one by one, each on its own row.
            row = (getattr(top, "children", None) or {}).get(a)
            if row and row[1] and row != rows.get(a):
                progressed = row[1] != page.children[a][1] and row[1][0] not in PENDING_STATES
                say(f"{stamp(start)} {shown(row[0])} now reads {shown(row[1][1])} (state {row[1][0]})"
                    + ("; the purchase went through, downloading" if progressed and not confirmed else ""))
                if progressed:
                    seen_sheet = confirmed = True
                rows[a] = row
        screen = Screen(s)
        state = screen.state()
        if screen.texts != last_texts and (state or seen_sheet):
            last_texts = screen.texts
            if state:
                say(f"{stamp(start)} the iPad shows:")
                for t in screen.texts[:14]:
                    say(f"    {private(t)}")
        if state:
            seen_sheet = True
            quiet_since = now
        if state == "error":
            say(f"{stamp(start)} the App Store reports a problem: "
                + "; ".join(private(t) for t in (screen.any(ERROR) or screen.alerts)[:3])
                + ". Nothing more is tapped; the iPad is left as it is.")
            return False
        if state == "always-ask":
            if len(screen.always) != 1:
                say(f"{stamp(start)} Apple asks whether later purchases need the password, and the "
                    f"dialog has {len(screen.always)} 'always' buttons, not one. Nothing was tapped; "
                    "the person answers it on the iPad.")
                return False
            s.read_app(screen.always_where)
            try:
                res = s.post(f"/element/{screen.always[0]}/click", {})
            finally:
                s.read_app(STORE)
            if isinstance(res.get("value"), dict) and res["value"].get("error"):
                say(f"{stamp(start)} the tap on 'always require' failed; the dialog is left as it is.")
                return False
            say(f"{stamp(start)} Apple asked whether later purchases need the password: answered "
                "'always require' (the stricter choice)")
            last_state = state
            continue
        if state == "password":
            if typed:
                say(f"{stamp(start)} the sheet asks for the password again: it was not accepted. This "
                    "script does not try again, because Apple locks an account after wrong passwords. "
                    "The sheet is left as it is.")
                return False
            if not asked:
                asked = True
                pw = ask_password()
                if pw:
                    stop = enter_password(s, screen, pw)
                    pw = None
                    if stop:
                        say(f"{stamp(start)} {stop} The sheet is left as it is.")
                        return False
                    typed = True
                    say(f"{stamp(start)} password entered once; waiting for the App Store")
                else:
                    say(f"{stamp(start)} {TODO['password-iPad' if pw is None else 'password-left']}")
            last_state = state
            continue
        if state == "confirm" and not confirmed:
            want = page.title if kind == "redownload" else page.offer[1] if kind == "price" else None
            if len(screen.confirm) != 1:
                say(f"{stamp(start)} the sheet has {len(screen.confirm)} buttons that could confirm, not "
                    "one. Nothing was tapped on it; the sheet is left as it is.")
                return False
            if not screen.shows(page.title) or (want and not screen.shows(want)):
                say(f"{stamp(start)} the sheet does not show {shown(page.title)}"
                    + (f" and {shown(want)}" if want else "")
                    + ". Nothing was tapped on it; the sheet is left as it is.")
                return False
            s.read_app(screen.where)
            try:
                res = s.post(f"/element/{screen.confirm[0]}/click", {})
            finally:
                s.read_app(STORE)
            if isinstance(res.get("value"), dict) and res["value"].get("error"):
                say(f"{stamp(start)} the tap on the sheet's button failed; the sheet is left as it is.")
                return False
            confirmed = True
            say(f"{stamp(start)} confirmed the purchase sheet once (it showed this {what}"
                + (" and this price" if kind == "price" else "") + ")")
        elif state in TODO and state != last_state:
            say(f"{stamp(start)} {TODO[state]}")
        elif state == "sheet" and last_state != "sheet":
            say(f"{stamp(start)} the purchase sheet is open")
        if state is None and seen_sheet and last_state not in ("start", None, "locked"):
            gone += 1
            if is_in is None:
                # A failed inventory read says nothing about the purchase.
                # Keep watching rather than recommending another purchase.
                if gone == 1:
                    say(f"{stamp(start)} cannot read the installed-app list; "
                        "purchase status is unknown. Waiting to verify it.")
                continue
            unread = top.offer is None or bool(apps) and not set(apps) <= set(top.children)
            if gone < 2 or (unread and not is_in):
                continue     # the sheet may be animating, the page not readable yet
            if top.offer == page.offer and (not apps or top.children == page.children) and not got:
                # Back to the price button (and, for a bundle, every app's row
                # as it was) without a download: the sheet closed.
                say(f"{stamp(start)} the sheet has closed and the {what}'s button reads "
                    f"{shown(top.offer[1])} again: nothing was bought (cancelled on the iPad, or "
                    "Apple's time to confirm ran out). Run the command again with the person at "
                    "the iPad.")
                return False
            confirmed = True
            say(f"{stamp(start)} the sheet has closed; the {what} is downloading")
        gone = 0
        last_state = state
        if not seen_sheet and now - quiet_since > 45 and not warned:
            warned = True
            say(f"{stamp(start)} no purchase sheet and no download this script can read, 45 s after "
                "the tap. The iPad shows:")
            for t in (screen.texts or ["(nothing this script can read)"])[:14]:
                say(f"    {private(t)}")
            say("Look at the iPad: a sheet there is one this script does not know yet (please report "
                "it); do what it asks. This script watches for the download for another 75 s.")
        if not seen_sheet and now - quiet_since > 120:
            say(f"{stamp(start)} no purchase sheet and no download 120 s after the tap: stopping. "
                "If nothing shows on the iPad, nothing was bought.")
            return False
    say(f"timed out after {args.timeout} s: installation of {bundle} could not be verified. Look at the iPad: a sheet "
        "may still wait for the person, or the download is still running.")
    return False


# --- Lock and the iPad's state ---------------------------------------------

def take_lock(app_id):
    if os.environ.get("IPAD_LOCK_HELD") == "1":
        return False
    try:
        os.mkdir(LOCK)
    except FileExistsError:
        def read(name):
            try:
                with open(os.path.join(LOCK, name)) as f:
                    return f.read().strip()
            except OSError:
                return "?"
        die(f"the iPad lock is held by: {read('owner')} ({read('note')}). Run this again when it is free.")
    with open(os.path.join(LOCK, "owner"), "w") as f:
        f.write("scripts/ipad-buy\n")
    with open(os.path.join(LOCK, "note"), "w") as f:
        f.write(f"App Store page of app {app_id}, since {time.strftime('%H:%M')}\n")
    return True


def aum_to_front():
    try:
        Session(AUM).close()
        say("AUM is in front: it keeps the iPad awake")
    except SystemExit:
        say("AUM could not be brought to the front. Do that soon (scripts/ipad launch aum), "
            "or the iPad locks itself.")


def main():
    p = argparse.ArgumentParser(prog="ipad-buy", add_help=False)
    p.add_argument("app")
    p.add_argument("--confirm-name")
    p.add_argument("--confirm-price")
    p.add_argument("--timeout", type=int, default=600)
    p.add_argument("--country")
    p.add_argument("-h", "--help", action="store_true")
    if any(a in ("-h", "--help") for a in sys.argv[1:]) or len(sys.argv) < 2:
        with open(__file__) as f:
            lines = f.read().splitlines()[1:]
        for line in lines:
            if not line.startswith("#"):
                break
            print(line[2:] if line.startswith("# ") else line[1:])
        return 0
    args = p.parse_args()
    if (args.confirm_name is None) != (args.confirm_price is None):
        die("a purchase needs both --confirm-name and --confirm-price; without either the script only looks")
    for v in (args.confirm_name, args.confirm_price):
        if v is not None and not v.strip():
            die("an empty confirmation is no confirmation")
    if args.timeout < 1:
        die("--timeout takes a number of seconds")
    if shutil.which("ios") is None:
        die("'ios' (go-ios) not found on PATH")

    app_id, url_cc, bundle = app_id_of(args.app)
    buying = args.confirm_price is not None
    locked = call("GET", "/wda/locked", timeout=10).get("value")
    if locked is not False:
        die("the iPad is locked (or WebDriverAgent cannot tell); unlock it first: scripts/ipad unlock")

    held = take_lock(app_id)
    try:
        country = (args.country or url_cc or device_country() or "us").lower()
        entry, bundle = catalogue(app_id, country, bundle)
        apps = [a["id"] for a in entry["apps"]] if bundle and entry else ()
        page = read_page(app_id, entry.get("trackName") if entry else None, bundle, apps)
        report(app_id, page, entry)
        reasons = check(page, entry, args)
        if not buying:
            if reasons:
                say("a purchase would be refused:")
                for r in reasons:
                    say(f"  - {r}")
            else:
                kind = offer_kind(*page.offer)
                say(f"to buy it, after the person who pays has confirmed this {'bundle' if bundle else 'app'} "
                    "and this price:")
                price = " ".join(unicodedata.normalize("NFKC", price_text(kind, page.offer[1])).split())
                which = f"https://apps.apple.com/{country}/app-bundle/id{app_id}" if bundle else app_id
                say(f"  scripts/ipad buy {which} --confirm-name {shlex.quote(page.title)} "
                    f"--confirm-price {shlex.quote(price)}")
            say("looked only: nothing was bought or downloaded")
            return 0
        if reasons:
            say("refused, nothing was tapped:")
            for r in reasons:
                say(f"  - {r}")
            return 1
        ok = buy(app_id, entry, page, args)
        return 0 if ok else 1
    except Refusal as e:
        say(f"refused: {e}")
        return 1
    finally:
        aum_to_front()
        if held:
            shutil.rmtree(LOCK, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
