#!/usr/bin/env bash
# ipad: drive the USB-connected iPad from Linux with go-ios.
#
#   tunnel                start the go-ios userspace tunnel (keep it running)
#   launch <app> [--restart]  launch an app (probe, aum, or a bundle ID)
#   screenshot [file]     save a screenshot
#   mount-ddi             personalize + mount the developer disk image (after a reboot)
#   wda                   run WebDriverAgent and forward its port (keep it running)
#   tap <label> [app]     tap the element with this accessibility label
#   tap-at <x> <y> [app]  tap a point (in points, not screenshot pixels)
#   hold <x> <y> [app]    long-press a point for 1.2 s
#   swipe <x1> <y1> <x2> <y2> [app]  drag from one point to another (scroll)
#   dtap <x> <y> [app]    double-tap a point
#   drag <x1> <y1> <x2> <y2> [<x3> <y3> ...] [app]  press, move through the
#                         points, hold, release (reorder nodes or channels, move windows)
#   confirm <x> <y> [app] tap a point twice, 0.5 s apart (two-step buttons such as CLEAR)
#   type <text> [app]     clear the first text field on screen and type text into it
#   enter [app]           press Return on the on-screen keyboard
#   fields [app]          list text fields and their values
#   size [app]            window size in points (tells the orientation)
#   tree [app]            print the accessibility tree (labels + positions)
#   status                tunnel / disk image / WebDriverAgent state
#   unlock [--dry-run]    type the passcode on the lock screen (asks for it; one try)
#
# One-time setup (go-ios, the disk image, WebDriverAgent, UI Automation) is in
# docs/ipad-automation.md. Nothing device- or account-specific lives here: bundle
# IDs are resolved on the device.
set -euo pipefail

GOIOS_HOME="${GOIOS_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/go-ios}"
GOIOS_CACHE="${GOIOS_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/go-ios}"
DDI_DIR="${DDI_DIR:-$GOIOS_CACHE/ddi}"
WDA_PORT="${WDA_PORT:-8100}"
WDA_URL="http://127.0.0.1:$WDA_PORT"

# Apple Root CA anchors gs.apple.com (Apple's signing server, needed to mount the
# disk image). Many Linux trust stores lack it, so it is fetched from apple.com
# once and pinned to its published SHA-256 fingerprint.
APPLE_ROOT_URL="https://www.apple.com/appleca/AppleIncRootCertificate.cer"
APPLE_ROOT_SHA256="B0:B1:73:0E:CB:C7:FF:45:05:14:2C:49:F1:29:5E:6E:DA:6B:CA:ED:7E:2C:68:C5:BE:91:B5:A1:10:01:F0:24"
APPLE_ROOT_PEM="$GOIOS_HOME/apple-root.pem"

die() { echo "ipad: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' not found on PATH (see docs/ipad-automation.md)"; }

usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }

# Run go-ios quietly: it logs JSON to stderr, which is shown only on failure.
goios() {
    local log rc=0
    log=$(mktemp)
    ios "$@" 2>"$log" || rc=$?
    if [ "$rc" -ne 0 ]; then cat "$log" >&2; fi
    rm -f "$log"
    return "$rc"
}

# State checks capture output first: with pipefail, `| grep -q` can report a
# false failure when grep exits early and the writer gets SIGPIPE.
tunnel_up() { local out; out=$(ios tunnel ls 2>/dev/null) || return 1; [[ $out == *'"udid"'* ]]; }
require_tunnel() { tunnel_up || die "no go-ios tunnel; start one with: $0 tunnel"; }
wda_ready() { local out; out=$(curl -s --max-time 3 "$WDA_URL/status" 2>/dev/null) || return 1; [[ $out =~ \"ready\"[[:space:]]*:[[:space:]]*true ]]; }
require_wda() { wda_ready || die "WebDriverAgent is not reachable on $WDA_URL; start it with: $0 wda"; }

# Resolve an app alias to the bundle ID installed on the device. xtool signs
# with a team prefix (XTL-<TEAMID>.), so the sideloaded apps are matched by
# suffix. Override with PROBE_BUNDLE_ID / WDA_BUNDLE_ID.
resolve_app() {
    case "$1" in
        aum) echo com.kymatica.AUM ;;
        probe) installed_id com.teemow.auv3probe "${PROBE_BUNDLE_ID:-}" ;;
        wda) installed_id com.facebook.WebDriverAgentRunner.xctrunner "${WDA_BUNDLE_ID:-}" ;;
        *) echo "$1" ;;
    esac
}

installed_id() {
    local suffix=$1 override=$2 id
    if [ -n "$override" ]; then echo "$override"; return; fi
    id=$(ios apps 2>/dev/null | python3 -I -c '
import json, sys
suffix = sys.argv[1]
data = json.load(sys.stdin)
apps = data if isinstance(data, list) else data.get("apps", [])
for app in apps:
    bid = app.get("CFBundleIdentifier", "")
    if bid == suffix or bid.endswith("." + suffix):
        print(bid)
        break
' "$suffix") || true
    [ -n "$id" ] || die "no installed app matching *$suffix (is the device connected and the app installed?)"
    echo "$id"
}

cmd_tunnel() {
    mkdir -p -m 700 "$GOIOS_HOME"
    tunnel_up && die "a go-ios tunnel is already running"
    echo "ipad: tunnel starting (identity in $GOIOS_HOME); Ctrl-C to stop" >&2
    exec ios tunnel start --userspace --pair-record-path="$GOIOS_HOME"
}

cmd_launch() {
    [ $# -ge 1 ] || die "usage: $0 launch <probe|aum|bundle-id> [--restart]"
    require_tunnel
    local id; id=$(resolve_app "$1")
    if [ "${2:-}" = "--restart" ]; then
        goios launch "$id" --kill-existing >/dev/null
    else
        goios launch "$id" >/dev/null
    fi
    echo "launched $id"
}

cmd_screenshot() {
    require_tunnel
    local out=${1:-$GOIOS_CACHE/screenshots/ipad-$(date +%Y%m%d-%H%M%S).png}
    mkdir -p "$(dirname "$out")"
    goios screenshot --output="$out" >/dev/null
    [ -s "$out" ] || die "screenshot failed"
    echo "$out"
}

ensure_apple_root() {
    [ -s "$APPLE_ROOT_PEM" ] && return
    need openssl
    local der; der=$(mktemp)
    curl -sSfL --max-time 30 -o "$der" "$APPLE_ROOT_URL" || { rm -f "$der"; die "could not fetch $APPLE_ROOT_URL"; }
    local fp
    fp=$(openssl x509 -inform DER -in "$der" -noout -fingerprint -sha256 | cut -d= -f2)
    if [ "$fp" != "$APPLE_ROOT_SHA256" ]; then rm -f "$der"; die "Apple Root CA fingerprint mismatch: $fp"; fi
    mkdir -p -m 700 "$GOIOS_HOME"
    openssl x509 -inform DER -in "$der" -out "$APPLE_ROOT_PEM"
    rm -f "$der"
}

cmd_mount_ddi() {
    require_tunnel
    [ -n "$(find "$DDI_DIR" -path '*/Restore/BuildManifest.plist' -print -quit 2>/dev/null)" ] \
        || die "no personalized disk image under $DDI_DIR (see docs/ipad-automation.md)"
    ensure_apple_root
    local system_ca=""
    for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/cert.pem; do
        if [ -s "$f" ]; then system_ca=$f; break; fi
    done
    [ -n "$system_ca" ] || die "no system CA bundle found"
    local bundle; bundle=$(mktemp)
    cat "$system_ca" "$APPLE_ROOT_PEM" >"$bundle"
    local rc=0
    SSL_CERT_FILE="$bundle" goios image auto --basedir="$DDI_DIR" >/dev/null || rc=$?
    rm -f "$bundle"
    if [ "$rc" -ne 0 ] || ! ddi_mounted; then die "mounting the disk image failed"; fi
    echo "disk image mounted"
}

ddi_mounted() { local out; out=$(ios image list 2>&1) || return 1; [[ $out == *'"signature"'* ]]; }

cmd_wda() {
    require_tunnel
    wda_ready && die "WebDriverAgent is already running on $WDA_URL"
    ddi_mounted || die "no developer disk image mounted; run: $0 mount-ddi"
    local id; id=$(resolve_app wda)
    WDA_PIDS=()
    trap 'kill "${WDA_PIDS[@]}" 2>/dev/null || true' EXIT INT TERM
    ios runwda --bundleid="$id" --testrunnerbundleid="$id" \
        --xctestconfig=WebDriverAgentRunner.xctest >/dev/null 2>&1 &
    WDA_PIDS+=($!)
    ios forward "$WDA_PORT" 8100 >/dev/null 2>&1 &
    WDA_PIDS+=($!)
    local i
    for i in $(seq 1 90); do
        wda_ready && break
        kill -0 "${WDA_PIDS[0]}" 2>/dev/null || die "WebDriverAgent exited; is Settings > Developer > Enable UI Automation on and the iPad unlocked?"
        sleep 1
    done
    wda_ready || die "WebDriverAgent did not become ready within 90 s"
    echo "ipad: WebDriverAgent ready on $WDA_URL; Ctrl-C to stop" >&2
    wait "${WDA_PIDS[0]}" || true
}

# WebDriverAgent HTTP client: open a session bound to an app, then act on it.
#   wda_client <action> <app bundle ID or ""> [args...]
# Actions: tree; tap <label>; tap-at <x> <y>; hold <x> <y>; swipe <x1> <y1> <x2> <y2>;
# size. Labels are matched exactly (case-insensitive). Coordinates are points in the
# app's current orientation.
wda_client() {
    python3 -I - "$WDA_URL" "$@" <<'PY'
import json, sys, time, urllib.request

base, action, app, args = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]

def call(method, path, body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(base + path, data=data, method=method,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.load(r)
    except TimeoutError:
        sys.exit("ipad: WebDriverAgent did not answer within 60 s. A plugin window with a "
                 "remote view open can hang it: restart `ipad wda`, then close the window "
                 "with tap-at (see docs/ipad-automation.md)")

def touch(steps):
    call("POST", f"/session/{sid}/actions", {"actions": [{
        "type": "pointer", "id": "finger", "parameters": {"pointerType": "touch"},
        "actions": steps}]})

def text_fields():
    return call("POST", f"/session/{sid}/elements",
                {"using": "class name", "value": "XCUIElementTypeTextField"})["value"]

def eid_of(el):
    return el.get("ELEMENT") or next(iter(el.values()))

def point(xs):
    try:
        return [float(v) for v in xs]
    except ValueError:
        sys.exit(f"ipad: {action} needs numeric coordinates, got {' '.join(xs)!r}")

# Bind the session to the app: in iPadOS windowed multitasking the "active
# application" is SpringBoard, so queries must be scoped to the bundle ID.
# forceAppLaunch=false brings a running app forward instead of relaunching it;
# shouldTerminateApp=false keeps WDA from killing the app when the session ends
# (its default would close AUM and drop the loaded session).
caps = {"shouldWaitForQuiescence": False}
if app:
    caps.update({"bundleId": app, "forceAppLaunch": False, "shouldTerminateApp": False})
sid = call("POST", "/session", {"capabilities": {"alwaysMatch": caps}})["sessionId"]
try:
    # Don't wait for the app to go idle before each action. An endless animation
    # (AUM spins the icon of a slot while its node picker is open) otherwise makes
    # every tap wait for XCTest's idle timeout, about 45 s.
    call("POST", f"/session/{sid}/appium/settings",
         {"settings": {"waitForIdleTimeout": 0, "animationCoolOffTimeout": 0}})
    if action == "tree":
        print(call("GET", f"/session/{sid}/source?format=description")["value"])
    elif action == "size":
        size = call("GET", f"/session/{sid}/window/size")["value"]
        w, h = size["width"], size["height"]
        print(f"{w:g} x {h:g} points ({'landscape' if w > h else 'portrait'})")
    elif action == "tap-at":
        x, y = point(args[:2])
        call("POST", f"/session/{sid}/wda/tap", {"x": x, "y": y})
        print(f"tapped at {x:g},{y:g}")
    elif action == "hold":
        x, y = point(args[:2])
        call("POST", f"/session/{sid}/wda/touchAndHold", {"x": x, "y": y, "duration": 1.2})
        print(f"held at {x:g},{y:g}")
    elif action == "swipe":
        x1, y1, x2, y2 = point(args[:4])
        # A W3C touch action: down, move over 300 ms, up. WDA's own drag endpoint
        # presses first, which AUM reads as a long-press.
        touch([{"type": "pointerMove", "duration": 0, "x": x1, "y": y1},
               {"type": "pointerDown", "button": 0},
               {"type": "pointerMove", "duration": 300, "x": x2, "y": y2},
               {"type": "pointerUp", "button": 0}])
        print(f"swiped {x1:g},{y1:g} -> {x2:g},{y2:g}")
    elif action == "dtap":
        x, y = point(args[:2])
        call("POST", f"/session/{sid}/wda/doubleTap", {"x": x, "y": y})
        print(f"double-tapped {x:g},{y:g}")
    elif action == "drag":
        pts = point(args)
        if len(pts) < 4 or len(pts) % 2:
            sys.exit("ipad: drag needs x y pairs: <x1> <y1> <x2> <y2> [<x3> <y3> ...]")
        # Press, move to each point over 400 ms with a short rest, hold 1 s, release.
        # AUM shows some drag states (a node's DSP % and latency, the reorder target)
        # only while the finger is still down, and drops a quick release.
        steps = [{"type": "pointerMove", "duration": 0, "x": pts[0], "y": pts[1]},
                 {"type": "pointerDown", "button": 0}]
        for i in range(2, len(pts), 2):
            steps += [{"type": "pointerMove", "duration": 400, "x": pts[i], "y": pts[i + 1]},
                      {"type": "pause", "duration": 150}]
        steps += [{"type": "pause", "duration": 1000}, {"type": "pointerUp", "button": 0}]
        touch(steps)
        print("dragged " + " -> ".join(f"{pts[i]:g},{pts[i + 1]:g}" for i in range(0, len(pts), 2)))
    elif action == "confirm":
        # AUM's two-step buttons (CLEAR, SAVE SESSION -> OVERWRITE?, REMOVE CHANNEL ->
        # TAP TO CONFIRM) take the second tap only for about a second.
        x, y = point(args[:2])
        call("POST", f"/session/{sid}/wda/tap", {"x": x, "y": y})
        time.sleep(0.5)
        call("POST", f"/session/{sid}/wda/tap", {"x": x, "y": y})
        print(f"tapped {x:g},{y:g} twice")
    elif action == "type":
        found = text_fields()
        if not found:
            sys.exit("ipad: no text field on screen")
        eid = eid_of(found[0])
        call("POST", f"/session/{sid}/element/{eid}/click", {})
        time.sleep(0.4)
        call("POST", f"/session/{sid}/element/{eid}/clear", {})
        call("POST", f"/session/{sid}/element/{eid}/value", {"value": list(args[0])})
        value = call("GET", f"/session/{sid}/element/{eid}/attribute/value")["value"]
        print(f"text field now {value!r}")
    elif action == "enter":
        call("POST", f"/session/{sid}/wda/keys", {"value": ["\n"]})
        print("pressed Return")
    elif action == "fields":
        for el in text_fields():
            eid = eid_of(el)
            rect = call("GET", f"/session/{sid}/element/{eid}/rect")["value"]
            value = call("GET", f"/session/{sid}/element/{eid}/attribute/value")["value"]
            print(f"text field at {rect['x']:g},{rect['y']:g} ({rect['width']:g} x {rect['height']:g}): {value!r}")
    elif action == "tap":
        label = args[0]
        # Prefer a button: a button's own text child usually carries the same label.
        wanted = "label ==[c] " + json.dumps(label)
        found = []
        for _ in range(10):
            for predicate in ("type == 'XCUIElementTypeButton' AND " + wanted, wanted):
                found = call("POST", f"/session/{sid}/elements", {"using": "predicate string", "value": predicate})["value"]
                if found:
                    break
            if found:
                break
            time.sleep(0.5)
        if not found:
            sys.exit(f"ipad: no element labelled {label!r} (list the labels with: ipad tree)")
        eid = eid_of(found[0])
        call("POST", f"/session/{sid}/element/{eid}/click", {})
        print(f"tapped {label!r}" + (f" ({len(found)} matches, used the first)" if len(found) > 1 else ""))
    else:
        sys.exit(f"ipad: unknown WebDriverAgent action {action!r}")
finally:
    try:
        call("DELETE", f"/session/{sid}")
    except Exception:
        pass
PY
}

# Optional trailing app argument (probe, aum, or a bundle ID) after <n> required
# ones. Callers assign it on its own line so that set -e stops on an unknown app.
app_arg() {
    local n=$1; shift
    if [ $# -gt "$n" ]; then resolve_app "${!#}"; fi
}

cmd_tap() {
    [ $# -ge 1 ] || die "usage: $0 tap <label> [probe|aum|bundle-id]"
    require_wda
    local app; app=$(app_arg 1 "$@")
    wda_client tap "$app" "$1"
}

cmd_tap_at() {
    [ $# -ge 2 ] || die "usage: $0 tap-at <x> <y> [probe|aum|bundle-id]"
    require_wda
    local app; app=$(app_arg 2 "$@")
    wda_client tap-at "$app" "$1" "$2"
}

cmd_hold() {
    [ $# -ge 2 ] || die "usage: $0 hold <x> <y> [probe|aum|bundle-id]"
    require_wda
    local app; app=$(app_arg 2 "$@")
    wda_client hold "$app" "$1" "$2"
}

cmd_swipe() {
    [ $# -ge 4 ] || die "usage: $0 swipe <x1> <y1> <x2> <y2> [probe|aum|bundle-id]"
    require_wda
    local app; app=$(app_arg 4 "$@")
    wda_client swipe "$app" "$1" "$2" "$3" "$4"
}

cmd_dtap() {
    [ $# -ge 2 ] || die "usage: $0 dtap <x> <y> [probe|aum|bundle-id]"
    require_wda
    local app; app=$(app_arg 2 "$@")
    wda_client dtap "$app" "$1" "$2"
}

cmd_confirm() {
    [ $# -ge 2 ] || die "usage: $0 confirm <x> <y> [probe|aum|bundle-id]"
    require_wda
    local app; app=$(app_arg 2 "$@")
    wda_client confirm "$app" "$1" "$2"
}

# drag takes any even number of coordinates; an odd count means the last word is the app.
cmd_drag() {
    [ $# -ge 4 ] || die "usage: $0 drag <x1> <y1> <x2> <y2> [<x3> <y3> ...] [probe|aum|bundle-id]"
    require_wda
    local app=""
    if [ $(($# % 2)) -eq 1 ]; then app=$(resolve_app "${!#}"); set -- "${@:1:$(($# - 1))}"; fi
    wda_client drag "$app" "$@"
}

cmd_type() {
    [ $# -ge 1 ] || die "usage: $0 type <text> [probe|aum|bundle-id]"
    require_wda
    local app; app=$(app_arg 1 "$@")
    wda_client type "$app" "$1"
}

cmd_enter() {
    require_wda
    local app; app=$(app_arg 0 "$@")
    wda_client enter "$app"
}

cmd_fields() {
    require_wda
    local app; app=$(app_arg 0 "$@")
    wda_client fields "$app"
}

cmd_size() {
    require_wda
    local app; app=$(app_arg 0 "$@")
    wda_client size "$app"
}

cmd_tree() {
    require_wda
    local app; app=$(app_arg 0 "$@")
    wda_client tree "$app"
}

cmd_status() {
    if tunnel_up; then echo "tunnel:     up"; else echo "tunnel:     down"; fi
    if tunnel_up && ddi_mounted; then echo "disk image: mounted"; else echo "disk image: not mounted (or no tunnel)"; fi
    if wda_ready; then echo "wda:        ready on $WDA_URL"; else echo "wda:        not running"; fi
}

case "${1:-}" in
    -h|--help|help|"") usage; exit 0 ;;
    # Needs WebDriverAgent only, not go-ios.
    unlock) shift; IPAD_WDA_URL="${IPAD_WDA_URL:-$WDA_URL}" exec "$(dirname "$0")/ipad-unlock" "$@" ;;
esac
need ios
need curl
need python3

case "${1:-}" in
    tunnel) shift; cmd_tunnel "$@" ;;
    launch) shift; cmd_launch "$@" ;;
    screenshot) shift; cmd_screenshot "$@" ;;
    mount-ddi) shift; cmd_mount_ddi "$@" ;;
    wda) shift; cmd_wda "$@" ;;
    tap) shift; cmd_tap "$@" ;;
    tap-at) shift; cmd_tap_at "$@" ;;
    hold) shift; cmd_hold "$@" ;;
    swipe) shift; cmd_swipe "$@" ;;
    dtap) shift; cmd_dtap "$@" ;;
    drag) shift; cmd_drag "$@" ;;
    confirm) shift; cmd_confirm "$@" ;;
    type) shift; cmd_type "$@" ;;
    enter) shift; cmd_enter "$@" ;;
    fields) shift; cmd_fields "$@" ;;
    size) shift; cmd_size "$@" ;;
    tree) shift; cmd_tree "$@" ;;
    status) shift; cmd_status "$@" ;;
    *) usage >&2; exit 2 ;;
esac
