<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>ProbeAudioTap</string>
    <key>CFBundleName</key>
    <string>ProbeAudioTap</string>
    <!-- Bonjour discovery of mcp-midi-controller runs in the extension process,
         so it needs its own Local Network permission + browsed service type. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>ProbeAudioTap finds your mcp-midi-controller on the local network to stream audio.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_mcpmidi._tcp</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsLocalNetworking</key><true/></dict>
    <!-- AUv3 audio effect with a UI: a classic NSExtension (com.apple.AudioUnit-UI).
         The principal class is the AUViewController / AUAudioUnitFactory; @objc(...)
         in the Swift source pins these bare class names under SwiftPM mangling. -->
    <key>NSExtension</key>
    <dict>
        <key>NSExtensionPointIdentifier</key>
        <string>com.apple.AudioUnit-UI</string>
        <key>NSExtensionPrincipalClass</key>
        <string>ProbeAudioTapViewController</string>
        <key>NSExtensionAttributes</key>
        <dict>
            <key>AudioComponents</key>
            <array>
                <dict>
                    <key>name</key>
                    <string>Tmow: ProbeAudioTap</string>
                    <key>description</key>
                    <string>Transparent audio tap that streams PCM + features over the LAN</string>
                    <key>factoryFunction</key>
                    <string>ProbeAudioTapViewController</string>
                    <key>manufacturer</key>
                    <string>Tmow</string>
                    <key>type</key>
                    <string>aufx</string>
                    <key>subtype</key>
                    <string>pbAu</string>
                    <key>version</key>
                    <integer>1</integer>
                    <key>sandboxSafe</key>
                    <true/>
                    <key>tags</key>
                    <array>
                        <string>Effects</string>
                    </array>
                </dict>
            </array>
        </dict>
    </dict>
</dict>
</plist>
